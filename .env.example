# Telegram bot token
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Admin username with @
ADMIN_USERNAME=@axixe

# Allowed users (comma-separated)
WHITELIST=@asyncr0

# Path to persisted bot data
DATA_FILE=bot_data.json


# VK API token with access to group photos
VK_TOKEN=PASTE_YOUR_VK_TOKEN_HERE

# VK group ID (digits only, without -)
VK_GROUP_ID=123456789

# VK album ID in the target group
VK_ALBUM_ID=1

# VK API version
VK_API_VERSION=5.199
